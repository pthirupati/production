# FixitLab — Local Development

# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=local-dev-secret-key-change-in-production-xyz123
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=fixitlab
POSTGRES_USER=fixitlab
POSTGRES_PASSWORD=fixitlab_secret
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=django-db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8080

# Docker provisioning
DOCKER_NETWORK=fixitlab_labs
DOCKER_IMAGE_PREFIX=fixitlab/scenario-
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_CONTAINER_TIMEOUT=1800

# Lab settings
LAB_MAX_DURATION_MINUTES=30
LAB_CLEANUP_INTERVAL_MINUTES=5

# Superuser (auto-created on startup)
SUPERUSER_USERNAME=thirupathip
SUPERUSER_EMAIL=thirupathi.samu2018@gmail.com
SUPERUSER_PASSWORD=Samatha@143

