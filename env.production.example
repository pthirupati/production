# ══════════════════════════════════════════════════════════════
#  FixitLab — Production Environment Variables
#  Copy to .env.production and fill in all values:
#    cp env.production.example .env.production
#
#  SECURITY: Never commit .env.production to version control!
# ══════════════════════════════════════════════════════════════

# ── Django Core ──
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=CHANGE-ME-use-python-to-generate-a-50-char-random-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=fixitlab.in,www.fixitlab.in

# ── PostgreSQL ──
POSTGRES_DB=fixitlab
POSTGRES_USER=fixitlab
POSTGRES_PASSWORD=CHANGE-ME-use-a-strong-password-min-24-chars
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-ME-use-a-strong-redis-password

# ── Celery (RabbitMQ) ──
CELERY_BROKER_URL=amqp://fixitlab:CHANGE-ME-rabbit-password@rabbitmq:5672//
RABBITMQ_USER=fixitlab
RABBITMQ_PASS=CHANGE-ME-rabbit-password

# ── CORS & CSRF ──
CORS_ALLOWED_ORIGINS=https://fixitlab.in,https://www.fixitlab.in
CSRF_TRUSTED_ORIGINS=https://fixitlab.in,https://www.fixitlab.in

# ── Frontend URL (used in emails, redirects) ──
FRONTEND_URL=https://fixitlab.in
SITE_URL=https://fixitlab.in

# ── SSL ──
SECURE_SSL_REDIRECT=true

# ── Email (SMTP — use Gmail App Password or SendGrid/SES) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# ── Contact Emails ──
PRIMARY_EMAIL=fixitlab.admin@gmail.com
PAYMENT_EMAIL=fixitlab.payment@gmail.com
SUPPORT_EMAIL=fixitlab.techsupport@gmail.com

# ── Social OAuth (GitHub) ──
# Create: https://github.com/settings/developers → New OAuth App
# Homepage URL: https://fixitlab.in
# Callback URL: https://fixitlab.in/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Social OAuth (Google) ──
# Create: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://fixitlab.in/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay (REQUIRED for real payments) ──
# Create: https://dashboard.razorpay.com → Settings → API Keys
# Test mode keys start with rzp_test_, live mode with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Stripe Billing (optional — legacy plan-based) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ── Currency Settings ──
# DEFAULT_CURRENCY: INR or USD (prices stored in this currency)
# ENABLE_CURRENCY_CONVERSION: true to auto-detect user's currency
DEFAULT_CURRENCY=INR
ENABLE_CURRENCY_CONVERSION=true

# ── Lab Provisioning ──
LAB_PROVIDER=docker
LAB_MAX_DURATION_MINUTES=60
LAB_CLEANUP_INTERVAL_MINUTES=5
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_NETWORK=fixitlab_labs
DOCKER_SCENARIO_IMAGE_PREFIX=fixitlab/scenario-
DOCKER_CONTAINER_MEMORY_LIMIT=512m
DOCKER_CONTAINER_CPU_LIMIT=1.0

# ── AWS (optional — for cloud lab provisioning) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── DigitalOcean (optional) ──
DO_API_TOKEN=
DO_REGION=nyc1

# ── Superuser (created on first boot) ──
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=thirupathi.samu2018@gmail.com
SUPERUSER_PASSWORD=CHANGE-ME-strong-admin-password

# ── Maintenance Mode ──
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are performing scheduled maintenance. Please check back soon.

# ── Business / Payment Account Details (shown on invoices) ──
BUSINESS_NAME=FixitLab
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_PAN=