# ══════════════════════════════════════════════════════════════
#  FixitLab — Production Environment Variables
#  Copy and fill in all values:
#    cp env.production.example .env.production
#
#  SECURITY: Never commit .env.production to version control!
#  Setup guide: docs/PRODUCTION_SETUP.md
# ══════════════════════════════════════════════════════════════

# ── Django Core [REQUIRED] ──
DJANGO_SETTINGS_MODULE=config.settings
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE-ME-use-django-secret-key-generator-50-chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=fixitlab.in,www.fixitlab.in

# ── PostgreSQL [REQUIRED] ──
POSTGRES_DB=fixitlab
POSTGRES_USER=fixitlab
POSTGRES_PASSWORD=CHANGE-ME-strong-password-min-24-chars
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ── Redis [REQUIRED] ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-ME-strong-redis-password-min-24-chars

# ── RabbitMQ (Celery) [REQUIRED] ──
CELERY_BROKER_URL=amqp://fixitlab:CHANGE-ME-rabbit-password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://fixitlab:CHANGE-ME-redis@redis:6379/2
RABBITMQ_USER=fixitlab
RABBITMQ_PASS=CHANGE-ME-rabbit-password

# ── CORS & CSRF [REQUIRED] ──
CORS_ALLOWED_ORIGINS=https://fixitlab.in,https://www.fixitlab.in
CSRF_TRUSTED_ORIGINS=https://fixitlab.in,https://www.fixitlab.in

# ── Frontend/Site URLs [REQUIRED] ──
FRONTEND_URL=https://fixitlab.in
SITE_URL=https://fixitlab.in

# ── SSL [REQUIRED] ──
SECURE_SSL_REDIRECT=true

# ── Email Configuration [REQUIRED] ──
# Use Gmail App Password (https://myaccount.google.com/app-passwords)
# Or use SendGrid API, AWS SES, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# ── Contact Emails [REQUIRED] ──
PRIMARY_EMAIL=fixitlab.admin@gmail.com
SUPPORT_EMAIL=fixitlab.techsupport@gmail.com
PAYMENT_EMAIL=fixitlab.payments@gmail.com

# ── Social OAuth (GitHub) [OPTIONAL] ──
# Create: https://github.com/settings/developers → New OAuth App
# Homepage URL: https://fixitlab.in
# Callback URL: https://fixitlab.in/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Social OAuth (Google) [OPTIONAL] ──
# Create: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://fixitlab.in/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────
# PAYMENT GATEWAYS [REQUIRED - AT LEAST ONE]
# ─────────────────────────────────────────

# ── Razorpay (RECOMMENDED for India) ──
# https://dashboard.razorpay.com → Settings → API Keys
# Test: rzp_test_*, Live: rzp_live_*
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=rzp_test_your_secret_here
RAZORPAY_WEBHOOK_SECRET=CHANGE-ME-razorpay-webhook-secret

# ── Stripe (Optional — legacy plan-based billing) ──
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_TEAM_PRICE_ID=price_xxxxx

# ─────────────────────────────────
# CURRENCY SETTINGS
# ─────────────────────────────────
# Supported: INR, USD, EUR, GBP, JPY, AUD, CAD
DEFAULT_CURRENCY=INR
# Auto-detect user's currency (requires geolocation API)
ENABLE_CURRENCY_CONVERSION=true

# ─────────────────────────────────
# LAB PROVISIONING
# ─────────────────────────────────
LAB_PROVIDER=docker
LAB_MAX_DURATION_MINUTES=60
LAB_CLEANUP_INTERVAL_MINUTES=5
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_NETWORK=fixitlab_labs
DOCKER_SCENARIO_IMAGE_PREFIX=fixitlab/scenario-
DOCKER_CONTAINER_MEMORY_LIMIT=512m
DOCKER_CONTAINER_CPU_LIMIT=1.0

# ─────────────────────────────────
# AWS (Optional — for cloud labs)
# ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_LAB_BASE_AMI=ami-0c7217cdde317cfec
AWS_LAB_AMI_PREFIX=fixitlab-scenario-
AWS_LAB_INSTANCE_TYPE=t3.micro
AWS_LAB_SUBNET_ID=
AWS_LAB_SECURITY_GROUP_ID=
AWS_LAB_KEY_PAIR=fixitlab-labs
AWS_LAB_KEY_PEM=
AWS_LAB_KEY_PATH=

# ─────────────────────────────────
# DigitalOcean (optional — not used; all labs run in Docker)
# ─────────────────────────────────
DO_API_TOKEN=
DO_SSH_KEY_ID=
DO_SSH_KEY_PEM=
DO_SSH_KEY_PATH=
DO_REGION=nyc1
DO_SIZE=s-1vcpu-1gb

# ─────────────────────────────────
# Jira Cloud — YOUR Atlassian account (not tied to VPS provider)
# ─────────────────────────────────
# 1. https://www.atlassian.com/software/jira → create project
# 2. https://id.atlassian.com/manage-profile/security/api-tokens
# 3. Webhook URL: https://yourdomain.com/api/jira/webhooks/?secret=SECRET
# Full guide: docs/JIRA_SETUP.md and docs/PRODUCTION_SETUP.md
JIRA_ENABLED=false
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=bot@yourorg.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=FIXIT
JIRA_ISSUE_TYPE=Task
JIRA_TRANSITION_IN_PROGRESS=In Progress
JIRA_TRANSITION_TODO=To Do
JIRA_TRANSITION_DONE=Done
JIRA_WEBHOOK_SECRET=CHANGE-ME-random-webhook-secret

# Disable demo/bypass payments in production
DEMO_PAYMENT_ENABLED=false

# ─────────────────────────────────
# BUSINESS DETAILS (Invoicing)
# ─────────────────────────────────
BUSINESS_NAME=FixitLab
BUSINESS_ADDRESS=Your Company Address
BUSINESS_GSTIN=
BUSINESS_PAN=

# ─────────────────────────────────
# SECURITY & LOGGING
# ─────────────────────────────────
# Enable structured JSON logging
ENABLE_JSON_LOGGING=true
LOG_LEVEL=INFO
# Send logs to external service (optional)
SENTRY_DSN=

# ─────────────────────────────────
# JWT (JSON Web Tokens) - RS256 configuration
# Provide either the PEM contents directly or mount files (preferred)
# Example (preferred): mount /etc/ssl/private/fixitlab_jwt.key and set JWT_RSA_PRIVATE_KEY_PATH
JWT_ALGORITHM=RS256
# Option A: PEM file paths (recommended)
JWT_RSA_PRIVATE_KEY_PATH=/etc/ssl/private/fixitlab_jwt.key
JWT_RSA_PUBLIC_KEY_PATH=/etc/ssl/certs/fixitlab_jwt_pub.pem
# Option B: inline PEM or aliases (JWT_SIGNING_KEY / JWT_VERIFYING_KEY also work)
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=
JWT_SIGNING_KEY=
JWT_VERIFYING_KEY=

# ─────────────────────────────────
# PERFORMANCE & FEATURES
# ─────────────────────────────────
USE_DB_CONNECTION_POOL=true
USE_REDIS_SENTINEL=false
CACHE_TTL=3600

# ── Superuser (created on first boot) ──
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=thirupathi.samu2018@gmail.com
SUPERUSER_PASSWORD=CHANGE-ME-strong-admin-password

# ── Maintenance Mode ──
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are performing scheduled maintenance. Please check back soon.

# ── Business / Payment Account Details (shown on invoices) ──
BUSINESS_NAME=FixitLab
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_PAN=