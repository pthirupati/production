# ══════════════════════════════════════════════════════════════
#  FixitLab — Production Environment Variables
#  Deploy on any server: copy this file to .env.production, set FRONTEND_URL,
#  ALLOWED_HOSTS, CORS/CSRF origins, and DB/Redis hosts — no code changes required.
#    cp env.production.example .env.production
#
#  SECURITY: Never commit .env.production to version control!
#  Setup guide: docs/PRODUCTION_SETUP.md
# ══════════════════════════════════════════════════════════════

# ── Django Core [REQUIRED] ──
DJANGO_SETTINGS_MODULE=config.settings
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE-ME-use-django-secret-key-generator-50-chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=fixitlab.in,www.fixitlab.in

# ── PostgreSQL [REQUIRED] ──
POSTGRES_DB=fixitlab
POSTGRES_USER=fixitlab
POSTGRES_PASSWORD=CHANGE-ME-strong-password-min-24-chars
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ── Redis [REQUIRED] ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-ME-strong-redis-password-min-24-chars

# ── RabbitMQ (Celery) [REQUIRED] ──
CELERY_BROKER_URL=amqp://fixitlab:CHANGE-ME-rabbit-password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://fixitlab:CHANGE-ME-redis@redis:6379/2
RABBITMQ_USER=fixitlab
RABBITMQ_PASS=CHANGE-ME-rabbit-password

# ── CORS & CSRF [REQUIRED] ──
CORS_ALLOWED_ORIGINS=https://fixitlab.in,https://www.fixitlab.in
CSRF_TRUSTED_ORIGINS=https://fixitlab.in,https://www.fixitlab.in

# ── Site URLs [REQUIRED] ──
FRONTEND_URL=https://fixitlab.in
SERVE_MEDIA=true
SITE_URL=https://fixitlab.in
SSL_DOMAIN=fixitlab.in
LETSENCRYPT_EMAIL=your-email@gmail.com

# ── SSL [REQUIRED] ──
SECURE_SSL_REDIRECT=true

# ── Admin IP allowlist (optional — comma-separated; empty = allow all) ──
ADMIN_ALLOWED_IPS=

# ── Deploy SSH (used by upload-secrets-to-github.sh only, not read by Django) ──
PROD_HOST=165.22.211.41
PROD_USER=root

# ── Off-site DB backup (admin enables in Settings → Database backups) ──
# Local pg_dump always runs on D3; S3/Spaces upload only when this is 1 AND SPACES_* are set.
BACKUP_OFFSITE_ENABLED=0
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_BUCKET=
# SPACES_REGION=blr1
# SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# SPACES_PREFIX=fixitlab

# ── Email (production: Gmail API on DigitalOcean — SMTP 587 is blocked) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
# Required on DigitalOcean/VPS — one-time setup: python scripts/setup-gmail-oauth.py
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Optional alternative (100/day free):
# SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=FixitLab <your-gmail@gmail.com>

# ── Contact Emails [REQUIRED] ──
PRIMARY_EMAIL=fixitlab.admin@gmail.com
SUPPORT_EMAIL=fixitlab.techsupport@gmail.com
PAYMENT_EMAIL=fixitlab.payments@gmail.com

# ── Social OAuth (GitHub) [OPTIONAL] ──
# Create: https://github.com/settings/developers → New OAuth App
# Homepage URL: https://fixitlab.in
# Authorization callback URL (exactly one — must match FRONTEND_URL):
#   https://fixitlab.in/auth/callback/github
# If you see "redirect_uri is not associated with this application", update this URL
# in GitHub → Settings → Developer settings → OAuth Apps → your app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Social OAuth (Google) [OPTIONAL] ──
# Create: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://fixitlab.in/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────
# PAYMENT GATEWAYS [REQUIRED - AT LEAST ONE]
# ─────────────────────────────────────────

# ── Razorpay (RECOMMENDED for India) ──
# https://dashboard.razorpay.com → Settings → API Keys
# Test: rzp_test_*, Live: rzp_live_*
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=rzp_test_your_secret_here
RAZORPAY_WEBHOOK_SECRET=CHANGE-ME-razorpay-webhook-secret

# ── Stripe (Optional — legacy plan-based billing) ──
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_TEAM_PRICE_ID=price_xxxxx

# ── AI Interview Studio (100% free — browser voice, no paid AI APIs) ──
INTERVIEW_ENABLED=true
INTERVIEW_VOICE_ENGINE=browser
INTERVIEW_AV_GRACE_SECONDS=300
INTERVIEW_ROUND_SCHEDULE_HOURS=48
INTERVIEW_STAFF_FREE_BY_DEFAULT=true
INTERVIEW_ALLOW_ADMIN_OBSERVER=true
INTERVIEW_FREE_CAMPAIGNS_PER_MONTH=1

# Marketing nurture emails (Celery beat daily — 5-day cadence per user)
MARKETING_EMAILS_ENABLED=true
MARKETING_NUDGE_INTERVAL_DAYS=5
MARKETING_MIN_ACCOUNT_AGE_DAYS=3
MARKETING_INACTIVE_LOGIN_DAYS=120

# Inactive account cleanup (no subscription within 3 months)
INACTIVE_ACCOUNT_CLEANUP_ENABLED=true
INACTIVE_ACCOUNT_MONTHS=3
INACTIVE_ACCOUNT_WARNING_DAYS=14

# ─────────────────────────────────
# CURRENCY SETTINGS
# ─────────────────────────────────
# Supported: INR, USD, EUR, GBP, JPY, AUD, CAD
DEFAULT_CURRENCY=INR
# Auto-detect user's currency (requires geolocation API)
ENABLE_CURRENCY_CONVERSION=true

# ─────────────────────────────────
# LAB PROVISIONING
# ─────────────────────────────────
LAB_PROVIDER=docker
LAB_MAX_DURATION_MINUTES=60
LAB_CLEANUP_INTERVAL_MINUTES=5
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_NETWORK=fixitlab_labs
DOCKER_SCENARIO_IMAGE_PREFIX=fixitlab/scenario-
DOCKER_CONTAINER_MEMORY_LIMIT=512m
DOCKER_CONTAINER_CPU_LIMIT=1.0

# ─────────────────────────────────
# AWS (Optional — for cloud labs)
# ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_LAB_BASE_AMI=ami-0c7217cdde317cfec
AWS_LAB_AMI_PREFIX=fixitlab-scenario-
AWS_LAB_INSTANCE_TYPE=t3.micro
AWS_LAB_SUBNET_ID=
AWS_LAB_SECURITY_GROUP_ID=
AWS_LAB_KEY_PAIR=fixitlab-labs
AWS_LAB_KEY_PEM=
AWS_LAB_KEY_PATH=

# ─────────────────────────────────
# DigitalOcean (optional — not used; all labs run in Docker)
# ─────────────────────────────────
DO_API_TOKEN=
DO_SSH_KEY_ID=
DO_SSH_KEY_PEM=
DO_SSH_KEY_PATH=
DO_REGION=nyc1
# List valid slugs: doctl compute size list -o json | jq -r '.[] | select(.available) | .slug'
# blr1 example: s-2vcpu-8gb-160gb-intel (legacy s-2vcpu-8gb is invalid)
DO_SIZE=s-1vcpu-1gb

# ─────────────────────────────────
# GoDaddy DNS (auto A record when droplet IP changes)
# Create keys: https://developer.godaddy.com/keys (Production key)
# ─────────────────────────────────
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_DOMAIN=fixitlab.in
DNS_TTL=600

# ─────────────────────────────────
# Jira Cloud — YOUR Atlassian account (not tied to VPS provider)
# ─────────────────────────────────
# Full guide: docs/JIRA_SETUP.md
# In-app Jira simulation (recommended): learners open /jira/KAN-123 without Atlassian login
JIRA_SIMULATION_MODE=true
JIRA_ENABLED=true
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your-atlassian-account@email.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task
JIRA_TRANSITION_IN_PROGRESS="In Progress"
JIRA_TRANSITION_TODO="To Do"
JIRA_TRANSITION_DONE=Done
JIRA_WEBHOOK_SECRET=CHANGE-ME-long-random-webhook-secret

# Demo payments when Razorpay keys are empty (set false when Razorpay live)
DEMO_PAYMENT_ENABLED=false

# ─────────────────────────────────
# BUSINESS DETAILS (Invoicing)
# ─────────────────────────────────
BUSINESS_NAME=FixitLab
BUSINESS_ADDRESS=Your Company Address
BUSINESS_GSTIN=
BUSINESS_PAN=

# ─────────────────────────────────
# SECURITY & LOGGING
# ─────────────────────────────────
# Enable structured JSON logging
ENABLE_JSON_LOGGING=true
LOG_LEVEL=INFO
# Send logs to external service (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# Operational alerts (Slack webhook or email)
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Admin network hardening (OPTIONAL, on top of superuser auth).
# IMPORTANT: an EMPTY ADMIN_ALLOWED_IPS together with FAIL_CLOSED=1 locks EVERY
# admin (even a logged-in superuser) out of ALL admin pages with a 403 — only
# enable fail-closed once you have populated the allowlist with your egress IP(s).
# Leave FAIL_CLOSED=0 (or unset) to keep admin reachable behind superuser auth.
ADMIN_ALLOWED_IPS=
ADMIN_FAIL_CLOSED_WITHOUT_ALLOWLIST=0

# pgBouncer connection pooling (runtime — migrations still use POSTGRES_HOST:5432)
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# When True, missing session tracker data rejects tokens (stricter; use with care on Redis outages).
JWT_SESSION_FAIL_CLOSED=0

JWT_ALGORITHM=HS256
JWT_HS256_SECRET=CHANGE-ME-same-as-or-different-from-DJANGO_SECRET_KEY
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=
JWT_RSA_PRIVATE_KEY_PATH=
JWT_RSA_PUBLIC_KEY_PATH=
JWT_SIGNING_KEY=
JWT_VERIFYING_KEY=

# ── Superuser (created on first boot only) ──
CREATE_SUPERUSER=1
SUPERUSER_SYNC_PASSWORD=1
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@fixitlab.in
SUPERUSER_PASSWORD=CHANGE-ME-strong-admin-password

# ── Maintenance Mode ──
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are performing scheduled maintenance. Please check back soon.

# ── HashiCorp Vault (recommended for production secrets) ──
# See docs/VAULT_SETUP.md — after bootstrap, set VAULT_ENABLED=true and use
# ./scripts/upload-vault-secrets-to-github.sh instead of PRODUCTION_ENV_B64.
# OAuth callback base (optional — defaults to FRONTEND_URL with www stripped for fixitlab.in)
# REQUIRED for GitHub login: in GitHub → Settings → Developer settings → OAuth Apps → your app,
# set Authorization callback URL to exactly: https://fixitlab.in/auth/callback/github
# GITHUB_OAUTH_CALLBACK_URL=https://fixitlab.in/auth/callback/github
# OAUTH_CALLBACK_BASE_URL=https://fixitlab.in
# Skip real SMTP/Gmail during CI/E2E (OTP still stored in DB for @fixitlab-test.local addresses)
# SKIP_EMAIL_TESTS=true
VAULT_ENABLED=true
VAULT_ADDR=http://127.0.0.1:8200
# VAULT_ROLE_ID=        # set in deploy/vault-approle.env after bootstrap
# VAULT_SECRET_ID=
# VAULT_UNSEAL_KEY=
# Make Vault the single source of truth so ROTATED values always win and no
# secret needs to live in this .env. With VAULT_OVERRIDE=1, keep ONLY the Vault
# bootstrap vars above (+ non-secret config) here; put every real secret
# (DJANGO_SECRET_KEY, JWT keys, DB/Redis passwords, Razorpay/AWS/OAuth/SMTP) in
# Vault. After rotating in Vault, run `python manage.py refresh_secrets` (picks
# up most secrets + JWT keys live) or do a rolling backend restart for a
# guaranteed cluster-wide pickup.
VAULT_OVERRIDE=1

# ── Business / Payment Account Details (shown on invoices) ──
BUSINESS_NAME=FixitLab
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_PAN=