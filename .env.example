# ══════════════════════════════════════════════════════════════
#  FixitLab — Environment Variables
#  Copy this file to .env and fill in all values:
#    cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Django Core ──────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=fixitlab
POSTGRES_USER=fixitlab
POSTGRES_PASSWORD=fixitlab_secure_password
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ / Celery ───────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── CORS & CSRF ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost

# ── Frontend & Site URLs ────────────────────────────────────
FRONTEND_URL=http://localhost:8080
SITE_URL=http://localhost:8080

# ── Contact Emails (configurable) ───────────────────────────
PRIMARY_EMAIL=fixitlab.admin@gmail.com
PAYMENT_EMAIL=fixitlab.payment@gmail.com
SUPPORT_EMAIL=fixitlab.techsupport@gmail.com

# ── Superuser ────────────────────────────────────────────────
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@fixitlab.com
SUPERUSER_PASSWORD=YourStrongPassword123!

# ── Email (Development — uses MailHog) ──────────────────────
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Email (Production — Gmail SMTP) ────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=fixitlab.admin@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── Social OAuth (GitHub) ──────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Social OAuth (Google) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe Billing (optional) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ── Lab Provisioning ──────────────────────────────────────
LAB_PROVIDER=docker
LAB_MAX_DURATION_MINUTES=60
LAB_CLEANUP_INTERVAL_MINUTES=5
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_NETWORK=fixitlab_labs
DOCKER_SCENARIO_IMAGE_PREFIX=fixitlab/scenario-
DOCKER_CONTAINER_MEMORY_LIMIT=512m
DOCKER_CONTAINER_CPU_LIMIT=1.0

# ── AWS (optional) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAYEOKPLEUJOWOSCBC
AWS_SECRET_ACCESS_KEY=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
AWS_REGION=ap-south-1
AWS_LAB_BASE_AMI=ami-03793655b06c6e29a
AWS_LAB_INSTANCE_TYPE=t3.micro
AWS_LAB_SUBNET_ID=subnet-0c4fe29dad449fbd2
AWS_LAB_SECURITY_GROUP_ID=sg-038e2edfb6d8aac56
AWS_LAB_KEY_PAIR=fixitlab-labs
AWS_LAB_KEY_PEM=
AWS_LAB_KEY_PATH=/scripts/fixitlab.pem

# ── DigitalOcean (optional) ────────────────────────────────
DO_API_TOKEN=
DO_SSH_KEY_ID=
DO_SSH_KEY_PEM=
DO_SSH_KEY_PATH=
DO_REGION=nyc1
DO_SIZE=s-1vcpu-1gb

# ── Maintenance Mode ───────────────────────────────────────
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance. Please check back soon.
