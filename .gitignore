# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Real environment / secret files (NEVER commit) ---
.env
.env.*
*.env
!*.env.example
!env.production.example
# Generated/rotated cluster env produced by ci-generate-secrets.py
.env.cluster
env.production
deploy/production.env
deploy/vault-init.json
deploy/vault-approle.env
deploy/labs_ssh/
deploy/*.env
env
venv/
.venv/
node_modules/
frontend/dist/
*.pem
*.key

# --- Self-hosted runtime assets (build output, NEVER commit) ---
# Pyodide and MediaPipe selfie-segmentation are served same-origin because the
# production CSP does not allow a public CDN. frontend/scripts/vendor-assets.mjs
# copies them out of node_modules during `npm run build` / `npm run dev`, so the
# ~25MB of binaries stay reproducible from package-lock.json instead of being
# committed to every clone forever.
frontend/public/pyodide/
frontend/public/vendor/

# --- User uploads & runtime-generated media (NEVER commit) ---
# MEDIA_ROOT = backend/media. Holds community thread attachments and the
# auto-generated Open Badge Ed25519 signing key (openbadge_signing_key.json) —
# both are per-host runtime artifacts / secrets, never source.
backend/media/

# --- Private owner/startup documentation (confidential — NEVER commit) ---
docs/private/

# Claude Code local session data & worktrees
.claude/
